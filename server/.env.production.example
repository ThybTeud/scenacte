# Configuration de production pour alwaysdata.net
# Copiez ce fichier en .env et remplacez les valeurs

# Base de données PostgreSQL (alwaysdata)
DATABASE_URL=postgresql://[compte]_scenacte:[password]@postgresql-[compte].alwaysdata.net:5432/[compte]_scenacte_db

# JWT Configuration (IMPORTANT: Générez une clé sécurisée longue et aléatoire)
JWT_SECRET=CHANGEZ_CE_SECRET_PAR_UNE_CHAINE_ALEATOIRE_LONGUE_ET_SECURISEE_AU_MOINS_32_CARACTERES
JWT_EXPIRES_IN=7d

# SMTP Configuration (alwaysdata fournit un serveur SMTP)
SMTP_HOST=smtp-[compte].alwaysdata.net
SMTP_PORT=587
SMTP_USER=[votre-email]@votre-domaine.com
SMTP_PASSWORD=[password_smtp]
SMTP_FROM=noreply@votre-domaine.com

# Server Configuration
PORT=8080
NODE_ENV=production

# Client Configuration (URL de votre frontend)
CLIENT_URL=https://votre-domaine.com

# Limits
MAX_CONTENT_SIZE_MB=10

# Notes :
# - Remplacez [compte] par votre nom de compte alwaysdata
# - Le PORT doit correspondre au port assigné par alwaysdata (généralement 8080)
# - Pour générer un JWT_SECRET sécurisé, utilisez : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
