// Scenacte - Schema Prisma
// PostgreSQL 16

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Table des utilisateurs
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String   @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  plays            Play[]
  exportTemplates  ExportTemplate[]

  @@map("users")
}

// Table des pièces de théâtre (version courante)
model Play {
  id               String       @id @default(uuid())
  userId           String       @map("user_id")
  title            String
  subtitle         String?
  rawContent       String       @map("raw_content")
  htmlContent      String       @map("html_content")
  contentVersion   Int          @default(1) @map("content_version")
  status           PlayStatus   @default(draft)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  lastEditedAt     DateTime     @default(now()) @map("last_edited_at")

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions         PlayVersion[]
  statistics       PlayStatistics?
  exportTemplates  ExportTemplate[]

  @@index([userId], name: "idx_plays_user_id")
  @@map("plays")
}

// Table de l'historique complet des versions
model PlayVersion {
  id               String           @id @default(uuid())
  playId           String           @map("play_id")
  versionNumber    Int              @map("version_number")
  title            String
  rawContent       String           @map("raw_content")
  htmlContent      String           @map("html_content")
  versionType      VersionType      @map("version_type")
  manualLabel      String?          @map("manual_label")
  fileSizeBytes    Int              @map("file_size_bytes")
  preservedReason  PreservedReason? @map("preserved_reason")
  createdAt        DateTime         @default(now()) @map("created_at")

  play             Play             @relation(fields: [playId], references: [id], onDelete: Cascade)
  statistics       VersionStatistics?

  @@index([playId], name: "idx_play_versions_play_id")
  @@index([playId, createdAt(sort: Desc)], name: "idx_play_versions_play_created")
  @@map("play_versions")
}

// Table des statistiques (version courante)
model PlayStatistics {
  id                       String   @id @default(uuid())
  playId                   String   @unique @map("play_id")
  totalActs                Int      @default(0) @map("total_acts")
  totalScenes              Int      @default(0) @map("total_scenes")
  totalCharacters          Int      @default(0) @map("total_characters")
  totalLines               Int      @default(0) @map("total_lines")
  wordCount                Int      @default(0) @map("word_count")
  estimatedDurationMinutes Int      @default(0) @map("estimated_duration_minutes")
  calculatedAt             DateTime @default(now()) @map("calculated_at")
  contentVersion           Int      @map("content_version")

  play                     Play     @relation(fields: [playId], references: [id], onDelete: Cascade)

  @@map("play_statistics")
}

// Table des statistiques par version historique
model VersionStatistics {
  id                       String      @id @default(uuid())
  versionId                String      @unique @map("version_id")
  totalActs                Int         @default(0) @map("total_acts")
  totalScenes              Int         @default(0) @map("total_scenes")
  totalCharacters          Int         @default(0) @map("total_characters")
  totalLines               Int         @default(0) @map("total_lines")
  wordCount                Int         @default(0) @map("word_count")
  estimatedDurationMinutes Int         @default(0) @map("estimated_duration_minutes")
  calculatedAt             DateTime    @default(now()) @map("calculated_at")

  version                  PlayVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("version_statistics")
}

// Table des templates d'export PDF
model ExportTemplate {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  playId    String?  @map("play_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  settings  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  play      Play?    @relation(fields: [playId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_export_templates_user_id")
  @@map("export_templates")
}

// Enums
enum PlayStatus {
  draft
  completed
  archived
}

enum VersionType {
  auto
  manual
}

enum PreservedReason {
  manual
  recent
  daily_snapshot
}