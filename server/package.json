{
  "name": "scenacte-server",
  "version": "1.0.0",
  "description": "Serveur API pour Scenacte - Éditeur de textes théâtraux",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "psql $DATABASE_URL -f db/migrations/000_init.sql",
    "pretest": "bash scripts/start-test-services.sh",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --coverage --runInBand",
    "lint": "eslint src/"
  },
  "keywords": [
    "theatre",
    "playwriting",
    "editor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "envalid": "^8.1.1",
    "express": "^4.21.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pagedjs": "^0.4.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "pg-boss": "^12.5.2",
    "pino": "^10.1.0",
    "resend": "^6.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.1.0",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
